        <mxCell id="214" value="可重叠的子流水线" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=#264f43;fontFamily=Microsoft YaHei;fontStyle=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="105" y="1620" width="4905" height="52.5" as="geometry" />
        </mxCell>
        <mxCell id="215" value="①　搬运与矩阵乘&lt;br&gt;Q、K 就绪即可发起 QK；V 只在 PV 前需要。缓冲可用时，DMA 可同时预取下一 KV 块。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontColor=#25443f;fontFamily=Microsoft YaHei;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="105" y="1690.5" width="1560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="216" value="②　同一个 m′ 分出两支&lt;br&gt;历史支路计算 α、u、C；当前支路计算 P。P 再分流到 z 和 CVT → PV，二者可独立推进。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontColor=#25443f;fontFamily=Microsoft YaHei;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1755" y="1690.5" width="1545" height="105" as="geometry" />
        </mxCell>
        <mxCell id="217" value="③　两条状态链在末尾汇合&lt;br&gt;ℓ′ 等 u 与 z，A′ 等 C 与 PV。最终 O 同时等 A_final 与分母倒数；LSE 有独立写回路径。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontColor=#25443f;fontFamily=Microsoft YaHei;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="3420" y="1690.5" width="1725" height="105" as="geometry" />
        </mxCell>
        <mxCell id="legend-formula" value="节点计时　τe(w,I,O) = Le + max(⌈w/pe⌉, ⌈I/Br,e⌉, ⌈O/Bw,e⌉)　　DMA 取 w=0。等待节点标的是就绪时刻 F。" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b60;fontSize=25;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="102" y="237" width="4990" height="56" as="geometry" />
        </mxCell>
