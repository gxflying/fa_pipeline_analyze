        </mxCell>
        <mxCell id="foot-b" value="a/q/k/v/h/o 为累加、Q/K/V、窄 P、输出 O 的 B/元素；s、b 分别为每块缩放常量、mask 的新供给字节。" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=20;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="122" y="1880" width="2445" height="58" as="geometry" />
