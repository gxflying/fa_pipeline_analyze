      <mxCell id="panel-bg0" value="" style="rounded=0;html=1;fillColor=#F1F6F5;strokeColor=none;pointerEvents=0;" parent="1" vertex="1">
        <mxGeometry x="44" y="1613" width="1721" height="244" as="geometry" />
      </mxCell>
      <mxCell id="panel-title0" value="读方块与箭头" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=23;fontColor=#183C3D;fontStyle=1;" parent="1" vertex="1">
        <mxGeometry x="64" y="1625" width="1681" height="36" as="geometry" />
      </mxCell>
      <mxCell id="panel-0-0" value="方块依次给出操作、结果和服务周期 τₑ(w,I,O)。w 为运算量，I/O 为读/写字节。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="65" y="1669" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-0-1" value="τₑ = Lₑ + max(⌈w/pₑ⌉, ⌈I/Bʳₑ⌉, ⌈O/Bʷₑ⌉)，DMA 取 w=0；MMA 的 w 按 MAC 计。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="65" y="1705" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-0-2" value="X=MN，Y=MD，U=DN，H=M，G=MND，J=M(N−1)。归约以二元比较或加法计数。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="65" y="1741" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-0-3" value="a/q/k/v/h/o 为累加、Q/K/V、Pₕ、O 的元素字节数；s、b 为每块缩放常量与 mask 读字节。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="65" y="1777" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-0-4" value="QK 汇合 Q、K（WQ）；PV 汇合 Pₕ、V（WV）。就绪门和状态视图的服务时间均为 0。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="65" y="1813" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-bg1" value="" style="rounded=0;html=1;fillColor=#F3F6F9;strokeColor=none;pointerEvents=0;" parent="1" vertex="1">
        <mxGeometry x="1783" y="1613" width="1721" height="244" as="geometry" />
      </mxCell>
      <mxCell id="panel-title1" value="同一时刻可以做什么" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=23;fontColor=#183C3D;fontStyle=1;" parent="1" vertex="1">
        <mxGeometry x="1803" y="1625" width="1681" height="36" as="geometry" />
      </mxCell>
      <mxCell id="panel-1-0" value="周期 392–652：DMA 搬入本块 V，同时 Tensor 执行 QK。本页只处理一个 KV 块。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="1804" y="1669" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-1-1" value="周期 861：SFU 求 α 的同时，ADD 开始算 S−m′。两路都已拿到 m′。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="1804" y="1705" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-1-2" value="周期 1059：P 同时送入 REDSUM 与 CVT。PV 只等 Pₕ 和 V；合并 A′ 才等 C 与 PV。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="1804" y="1741" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-1-3" value="INV 和 LOG 共用 SFU，RL 和 RA 共用 MUL。DMA 的读写分行，共用一个单元。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="1804" y="1777" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-1-4" value="所有入值就绪且执行单元空闲后发射。操作完成时，其整个输出块可供后继读取。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="1804" y="1813" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-bg2" value="" style="rounded=0;html=1;fillColor=#F1F6F5;strokeColor=none;pointerEvents=0;" parent="1" vertex="1">
        <mxGeometry x="3522" y="1613" width="1721" height="244" as="geometry" />
      </mxCell>
      <mxCell id="panel-title2" value="输入、边界与完成时间" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=23;fontColor=#183C3D;fontStyle=1;" parent="1" vertex="1">
        <mxGeometry x="3542" y="1625" width="1681" height="36" as="geometry" />
      </mxCell>
      <mxCell id="panel-2-0" value="M=64，N=D=128，1 GHz。累加 4 B，其余元素 2 B；s=0，b=4MN，端口与延迟同第 2 页。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="3543" y="1669" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-2-1" value="假设每行至少一个有效 key，m₀=−∞、ℓ₀=A₀=0；初值在 cycle 0 已可读，每条出边按其消费者所属分支着色。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="3543" y="1705" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-2-2" value="本例显式走通式。若启用首块折叠，直接取 m′=r、ℓ′=z、A′=Y₀，可跳过历史合并。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="3543" y="1741" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-2-3" value="本页按聚合端口模型计算，LSE 在 1157 cycle、O 在 1651 cycle 写完（1.651 µs）。共享 L1 和 RF 端口请按第 4 页另计。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="3543" y="1777" width="1679" height="33" as="geometry" />
      </mxCell>
      <mxCell id="panel-2-4" value="首块折叠时，相同配置的端到端为 1579 cycle。可用 schedule 脚本按 1 块 barrier 复算。" style="text;html=1;fontFamily=Microsoft YaHei;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontSize=17;fontColor=#4F6672;fontStyle=0;" parent="1" vertex="1">
        <mxGeometry x="3543" y="1813" width="1679" height="33" as="geometry" />
      </mxCell>
