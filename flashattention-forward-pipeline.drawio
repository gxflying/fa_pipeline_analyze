      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=24;fontColor=#193D42;fontStyle=1;" id="rfhead" value="Vector 通过 LD / ST 访问 L1，在 RF 中计算">
        <mxGeometry x="1585" y="3296" width="1504" height="38" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="rfbody0" value="RR(x)=C(x,B_Rr)，RW(x)=C(x,B_Rw)。B_Rr / B_Rw 为 RF 总读 / 写带宽。">
        <mxGeometry x="1585" y="3342" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="rfbody1" value="LD(x)=max{C(x,B_1r), C(x,B_LD), RW(x)}　　L1 读，RF 写。">
        <mxGeometry x="1585" y="3378" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="rfbody2" value="ST(y)=max{RR(y), C(y,B_ST), C(y,B_1w)}　　RF 读，L1 写。">
        <mxGeometry x="1585" y="3414" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="rfbody3" value="对某步，令 i/o 为 ALU 读取/生成的 RF 字节，x/y 为 LD/ST 字节。RF 总读 i+y，总写 o+x。">
        <mxGeometry x="1585" y="3450" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="rfbody4" value="若顺次执行 LD→计算→ST，E=max{RR(i),⌈w/pₑ⌉,RW(o)}，服务时间为 LD(x)+E+ST(y)。">
        <mxGeometry x="1585" y="3486" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="rfbody5" value="E 假设计算内部按元素流式推进。RF 总读写列用于端口预算；套用上式时各段各计一次。">
        <mxGeometry x="1585" y="3522" width="1504" height="34" as="geometry" />
      </mxCell>
