        <mxGeometry x="69" y="3646" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="limitsbody1" value="DDR、DMA、Tensor、各 Vector 单元还须满足各自的容量，且消费者等待生产者完成。">
        <mxGeometry x="69" y="3682" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="limitsbody2" value="公式默认读写端口独立。若 L1 共用半双工端口，改用 C(Σ L1读+Σ L1写, B_1)。">
        <mxGeometry x="69" y="3718" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="limitsbody3" value="算术列给理想吞吐服务拍数。启动、归约树深、等待和共享端口仲裁按目标硬件另计。">
        <mxGeometry x="69" y="3754" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="limitsbody4" value="RF 容量不足时，逐值增加一次 ST(字节数) 和每次重新取用的 LD(字节数)；同步增加 RF 端口量。">
        <mxGeometry x="69" y="3790" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="rounded=0;html=1;fillColor=#EEF4F3;strokeColor=none;pointerEvents=0;" id="examplepad" value="">
        <mxGeometry x="1566" y="3589" width="1542" height="249" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=24;fontColor=#193D42;fontStyle=1;" id="examplehead" value="S1 示例　·　一次载入如何占用两个端口">
        <mxGeometry x="1585" y="3600" width="1504" height="38" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="examplebody0" value="M=64、N=D=128、a=4。X₀ 为 32,768 B，σ 已在 RF，占 4 B；S₀ 在 RF 中生成 32,768 B。">
        <mxGeometry x="1585" y="3646" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="examplebody1" value="设 B_1r=B_LD=256、B_Rr=B_Rw=512 B/cycle，p_MUL=128 元素/cycle。">
        <mxGeometry x="1585" y="3682" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="examplebody2" value="LD=max(128,64)=128 拍。t算=⌈8192/128⌉=64 拍。运算段读 RF 65 拍，写 RF 64 拍。">
        <mxGeometry x="1585" y="3718" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="examplebody3" value="顺次执行需 128+max(65,64,64)+0=193 拍。RF 总写为 65,536 B（载入及写结果各一次）。">
        <mxGeometry x="1585" y="3754" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="examplebody4" value="本例带宽用于说明第 4 页的端口模型。第 3 页的 1651 cycle 来自原聚合端口配置。">
        <mxGeometry x="1585" y="3790" width="1504" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontColor=#193D42;fontStyle=1;" id="sum-label" value="整块流量核对　·　M=64，N=D=128，单块、稠密 mask 已在 L1">
        <mxGeometry x="50" y="3858" width="3058" height="38" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontColor=#193D42;fontStyle=0;" id="sum-ddr" value="DDR 读=qY+kU+vU=81,920 B，写=oY+aH=16,640 B。若从 DDR 搬入 mask，另计 DDR 读 b、L1 写 b 以及相应 DMA 服务。">
        <mxGeometry x="50" y="3905" width="3060" height="33" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontColor=#193D42;fontStyle=0;" id="sum-l1" value="L1 读=(qY+kU+hX+vU)Tensor+(aX+b+aY)Vector+(oY+aH)DMA=213,248 B。L1 写=(qY+kU+vU)DMA+(aX+aY)Tensor+(hX+oY+aH)Vector=180,480 B。">
        <mxGeometry x="50" y="3946" width="3060" height="33" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="state-info" value="入口视图 M0/L0/A0 指向 RF 中的 m₀[M,1]、ℓ₀[M,1]、A₀[M,D]，均为 F32（aH、aH、aY B）。WQ 等 Q/K，WV 等 Pₕ/V；就绪门本身搬运 0 B、运算 0 拍。">
        <mxGeometry x="50" y="3988" width="3060" height="33" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontColor=#193D42;fontStyle=0;" id="sum-rf" value="RF 总读 = 430,084 B 运算取数 + 33,024 B 供 ST 取数 = 463,108 B。RF 总写 = 264,704 B 运算结果 + 98,304 B 来自 LD = 363,008 B。">
        <mxGeometry x="50" y="4027" width="3060" height="33" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="broadcast" value="若硬件每 g 个 lane 从 RF 重读一次行参数，P1 对 m′ 的读量由 aH 改为 aH⌈N/g⌉。B_DMA↓/↑、B_Tin/out、B_LD/ST 分别为 DMA、Tensor 和 Vector 搬运通路带宽。">
        <mxGeometry x="50" y="4066" width="3060" height="33" as="geometry" />
      </mxCell>
      <object id="link-legacy" label="查看第 3 页的示例时间轴  →" link="data:page/id,single-dependency" tooltip="查看第 3 页的示例时间轴  →">
        <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=right;verticalAlign=middle;fontSize=18;fontColor=#245F76;fontStyle=1;">
          <mxGeometry x="2510" y="88" width="590" height="42" as="geometry" />
        </mxCell>
      </object>
    </root>
  </mxGraphModel>
</diagram>
