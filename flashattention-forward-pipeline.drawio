        <mxCell id="pair-form" parent="1" vertex="1" value="双槽　d+c+(T−1)max(d,c) = 1300 cycle　　单槽　T(d+c) = 2080 cycle" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=19;fontStyle=1;spacing=0;">
          <mxGeometry x="56" y="1875" width="1140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="detail-lower" parent="1" vertex="1" value="块 3 的 QK：两区需等 A1₁ 回收槽，2033 开始；三区在 1952 即可发射。增加一份计算暂存区，此例可提前 81 cycle。" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=20;fontStyle=0;spacing=0;">
          <mxGeometry x="1250" y="1825" width="1075" height="88" as="geometry" />
        </mxCell>
        <mxCell id="rulebg" parent="1" vertex="1" value="" style="rounded=0;html=1;fillColor=#edf2f5;strokeColor=none;">
          <mxGeometry x="54" y="1945" width="2290" height="127" as="geometry" />
        </mxCell>
        <mxCell id="rule1" parent="1" vertex="1" value="排程　S = max(前驱完成，槽可复用，同单元空闲)　　F = S + τe(w,I,O)　　C = max(F_OS, F_LS)" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=23;fontStyle=1;spacing=0;">
          <mxGeometry x="75" y="1953" width="2240" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule2" parent="1" vertex="1" value="示例端口（B/cycle）：DMA 外存 128、片上 1024；Tensor / 各 Vector 单元独立读 1024、写 512。Tensor 4096 MAC/cycle；MUL/ADD/MAX/归约 128，EXP 64，CVT 256，RCP/LOG 32。延迟与仲裁见说明 §6–7。" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=18;fontStyle=0;spacing=0;">
          <mxGeometry x="75" y="2004" width="2230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="rule3" parent="1" vertex="1" value="额外延迟 L（cycle）　DMA、Tensor、EXP = 4　　MUL、ADD/SUB、MAX、CVT = 2　　REDMAX、REDSUM = 7　　RCP = 5　　LOG = 6　　视图和就绪事件 = 0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#253b45;">
          <mxGeometry x="75" y="2080" width="2250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="rule4" parent="1" vertex="1" value="工作负载　q=k=v=h=o=2，a=4 B/元素，s=0，b=4MN B/块。窄条右侧数字为开始 cycle，完整起止区间见说明 §8。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#253b45;">
          <mxGeometry x="75" y="2126" width="2250" height="42" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
