        <mxCell id="173" value="&lt;div style=&quot;font-size:13px;color:#765888&quot;&gt;&lt;b&gt;VECTOR　LSE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Add · 合成 LSE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;LSE = m_final + g&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;两个 [M,1] → [M,1]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;输出 LSE 时 M ADD&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = 2·a·H　 O = a·H&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τADD(H, I, O)&lt;/b&gt;　·　3 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#f6f2fa;strokeColor=#765888;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
