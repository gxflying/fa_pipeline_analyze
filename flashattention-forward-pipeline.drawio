        </mxCell>
        <mxCell id="140" value="外层换 Qᵢ；内层固定 Qᵢ，依次取 Kⱼ、Vⱼ。QK 直接使用 Kⱼ，PV 使用 Vⱼᵀ 的逻辑视图。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#25443f;fontFamily=Microsoft YaHei;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="105" y="582" width="1582.5" height="45" as="geometry" />
        </mxCell>
        <mxCell id="141" value="m、ℓ 是每行一个 FP32 统计量 [M,1]，A 是 FP32 未归一化分子 [M,D]。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#25443f;fontFamily=Microsoft YaHei;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="105" y="643.5" width="1530" height="57" as="geometry" />
        </mxCell>
        <mxCell id="142" value="首块取 m′ = r、ℓ′ = z、A′ = PV，可跳过历史重标。以下节点计数按一个非首满块标注。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#25443f;fontFamily=Microsoft YaHei;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="105" y="702" width="1560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="143" value="读图示例：P 同时送 FP32 行求和与低精度 CVT；PV 等待 P 的转换和 V 的到达。分母只在最终归一化时与分子汇合。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#1b6555;fontFamily=Microsoft YaHei;fontStyle=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="105" y="774" width="1575" height="75" as="geometry" />
        </mxCell>
        <mxCell id="144" value="&lt;div style=&quot;font-size:13px;color:#406b95&quot;&gt;&lt;b&gt;DMA / I/O　Q&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Load Qᵢ&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;读入并保留 query 块&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[Mq,D] → [M,D]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;MD 元素 / 外层 Q 块&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = q·Y　 O = q·Y&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τIN(0, I, O)&lt;/b&gt;　·　132 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#eaf2fc;strokeColor=#406b95;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="105" y="898.5" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="145" value="&lt;div style=&quot;font-size:13px;color:#406b95&quot;&gt;&lt;b&gt;DMA / I/O　K&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Load Kⱼ&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;读取当前 key 列块&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[D,Nkv] → [D,N]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;DN 元素 / KV 块&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = k·U　 O = k·U&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τIN(0, I, O)&lt;/b&gt;　·　260 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#eaf2fc;strokeColor=#406b95;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="105" y="1317" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="146" value="&lt;div style=&quot;font-size:13px;color:#566a7b&quot;&gt;&lt;b&gt;CONTROL · 等待　WQ&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Wait · Q / K&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;等待 Qbuf、Kbuf 就绪&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[M,D] 与 [D,N] 可读&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;每块 1 个逻辑汇合点&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = 0　 O = 0　（仅事件）&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;F = max(F_Q, F_K)；t = 0&lt;/b&gt;　·　0 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#edf1f4;strokeColor=#566a7b;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="105" y="1084.5" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="147" value="&lt;div style=&quot;font-size:13px;color:#24685c&quot;&gt;&lt;b&gt;TENSOR · MMA　QK&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;MM · QK&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;X = Qᵢ Kⱼ&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[M,D] × [D,N] → [M,N]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;MND MAC&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = q·Y+k·U　 O = a·X&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τT(G, I, O)&lt;/b&gt;　·　260 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#e0f1eb;strokeColor=#24685c;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="447" y="1084.5" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="148" value="&lt;div style=&quot;font-size:13px;color:#765888&quot;&gt;&lt;b&gt;VECTOR　S1&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Mul · score 缩放&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;S₀ = X × s，s = 1/√D&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[M,N] × 标量 → [M,N]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;MN MUL&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = a·X+s　 O = a·X&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τMUL(X, I, O)&lt;/b&gt;　·　66 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#f6f2fa;strokeColor=#765888;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="789" y="1084.5" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="149" value="&lt;div style=&quot;font-size:13px;color:#765888&quot;&gt;&lt;b&gt;VECTOR　S2&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Add · mask&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;S = S₀ + B&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;两个 [M,N] → [M,N]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;MN ADD，含 mask 的块&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = a·X+b　 O = a·X&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τADD(X, I, O)&lt;/b&gt;　·　66 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#f6f2fa;strokeColor=#765888;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="1131" y="1084.5" width="300" height="150" as="geometry" />
        </mxCell>
