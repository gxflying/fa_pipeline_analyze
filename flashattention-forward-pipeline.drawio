        <mxCell id="169" value="&lt;div style=&quot;font-size:13px;color:#765888&quot;&gt;&lt;b&gt;VECTOR　OUT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Mul · 归一化&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;O₃₂ = A_final × v&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[M,D] × [M,1] → [M,D]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;末块 MD MUL&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = a·(Y+H)　 O = a·Y&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τMUL(Y, I, O)&lt;/b&gt;　·　66 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#f6f2fa;strokeColor=#765888;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="4209" y="1084.5" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="170" value="&lt;div style=&quot;font-size:13px;color:#765888&quot;&gt;&lt;b&gt;VECTOR　OC&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;CVT · 输出转换&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;O = cast(O₃₂)&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[M,D] FP32 → [M,D] BF16&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;末块 MD CVT&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = a·Y　 O = o·Y&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τCVT(Y, I, O)&lt;/b&gt;　·　34 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#f6f2fa;strokeColor=#765888;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="4551" y="1084.5" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="171" value="&lt;div style=&quot;font-size:13px;color:#406b95&quot;&gt;&lt;b&gt;DMA / I/O　OS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Store Oᵢ&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;写回该 Q 块的最终输出&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[M,D] → O[Mq,D]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;末块写 MD 元素&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = o·Y　 O = o·Y&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τST(0, I, O)&lt;/b&gt;　·　132 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#eaf2fc;strokeColor=#406b95;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="4893" y="1084.5" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="172" value="&lt;div style=&quot;font-size:13px;color:#765888&quot;&gt;&lt;b&gt;VECTOR　LOG&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Log · 分母对数&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;g = log(ℓ_final)&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;[M,1] → [M,1]&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#425955&quot;&gt;输出 LSE 时 M LOG&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;I = a·H　 O = a·H&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#283c60&quot;&gt;&lt;b&gt;t = τLOG(H, I, O)&lt;/b&gt;　·　8 cyc&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeWidth=1.6;fillColor=#f6f2fa;strokeColor=#765888;fontColor=#18332f;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
