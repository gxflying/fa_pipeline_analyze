      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=24;fontColor=#193D42;fontStyle=1;" id="memhead" value="DDR 与 Tensor 共用的 L1 端口">
