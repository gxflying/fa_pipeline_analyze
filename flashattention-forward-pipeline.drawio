      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="membody1" value="D↓(x) = max{C(x,B_Dr), C(x,B_1w), C(x,B_DMA↓)}　　DDR 读，L1 写。">
        <mxGeometry x="69" y="3378" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="membody2" value="D↑(x) = max{C(x,B_1r), C(x,B_Dw), C(x,B_DMA↑)}　　L1 读，DDR 写。">
        <mxGeometry x="69" y="3414" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="membody3" value="TR(x) = max{C(x,B_1r), C(x,B_Tin)}　　TW(y) = max{C(y,B_Tout), C(y,B_1w)}。">
        <mxGeometry x="69" y="3450" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="membody4" value="Tensor 直接从 L1 读两输入，并把结果写 L1。每个操作数按片内理想复用只读一遍。">
        <mxGeometry x="69" y="3486" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=18;fontColor=#50676D;fontStyle=0;" id="membody5" value="Tensor 内部累加或转置视图不占 Vector RF。若硬件重读或实际转置，按实际链路追加字节。">
        <mxGeometry x="69" y="3522" width="1462" height="34" as="geometry" />
      </mxCell>
      <mxCell parent="1" vertex="1" style="rounded=0;html=1;fillColor=#EEF4F3;strokeColor=none;pointerEvents=0;" id="rfpad" value="">
