        </mxCell>
        <mxCell id="foot-a" value="X=MN　Y=MD　U=DN　H=M　G=MND（MAC）　J=M(N−1)（二元归约）" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=23;fontStyle=1;spacing=0;" vertex="1" parent="1">
