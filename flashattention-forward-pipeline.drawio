        <mxCell id="foot-c" value="单位　p：工作量/cycle　　Br、Bw：B/cycle　　L：额外延迟（cycle）" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=23;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2595" y="1834" width="2450" height="39" as="geometry" />
        </mxCell>
        <mxCell id="foot-d" value="I、O 含片上复用与广播；所列端口各自预留。状态视图额外搬运为 0。示例硬件、首块旁路和跨块起止时刻见第 2 页与说明 §6–8。" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#253b45;fontSize=20;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2595" y="1880" width="2430" height="58" as="geometry" />
        </mxCell>
