        <mxCell id="11" value="&lt;b&gt;PV&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px&quot;&gt;窄 P × V → Y&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E4EEFA;strokeColor=#567BA7;strokeWidth=1.4;fontColor=#182B42;fontSize=16;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
