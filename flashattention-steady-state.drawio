        <mxCell id="op969" value="缩放常量初始化 · 独立局部时间轴，1 px/cycle" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=22;" parent="1" vertex="1">
          <mxGeometry x="25" y="2575" width="1750" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op970" value="参数路径　SQRT(D) → RCP(√D)；D 对同一 Q 块保持常量，两项各执行一次。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2613" width="1750" height="28" as="geometry" />
        </mxCell>
        <mxCell id="op971" value="" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;fillColor=#d8e4f1;strokeColor=#617c95;strokeWidth=0.3;" parent="1" vertex="1">
          <mxGeometry x="530" y="2655" width="1" height="24" as="geometry" />
        </mxCell>
        <mxCell id="op972" value="SQRT  [0,1)   ceil(1/P_sqrt)=1 c" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="545" y="2651" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op973" value="" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;fillColor=#d8e4f1;strokeColor=#617c95;strokeWidth=0.3;" parent="1" vertex="1">
          <mxGeometry x="531" y="2691" width="1" height="24" as="geometry" />
        </mxCell>
        <mxCell id="op974" value="RCP     [1,2)   ceil(1/P_rcp)=1 c" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="545" y="2687" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op975" value="可选直接 DIV 归一化 · 从末块 A、ℓ 就绪计时，1 px/cycle" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=22;" parent="1" vertex="1">
          <mxGeometry x="2100" y="2575" width="2600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op976" value="DIV · MD / P_div = 8192 / 8 = 1024 cycle" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;fillColor=#f8e6cc;strokeColor=#b48a58;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="2100" y="2625" width="1024" height="44" as="geometry" />
        </mxCell>
        <mxCell id="op977" value="直接 DIV 路径替换主图的 RCP+MUL，两条归一化路径择一执行；后续转换与回写须相应后移。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="2100" y="2681" width="2550" height="40" as="geometry" />
        </mxCell>
        <mxCell id="op978" value="独立吞吐参数　P_add=P_sub=P_mul=P_max=P_cvt=64；P_redmax=P_redsum=64；P_exp=P_div=P_rcp=P_sqrt=8。每类操作另有独立尾延迟 L_op，未指定值取0。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2750" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op979" value="资源映射　各 MUL、ADD、SUB、MAX、CVT 行共用一套基础 ALU；两个 EXP 行共用一套 EXP；REDMAX、REDSUM 各有独立单元。RCP、SQRT 采用独立特殊函数资源。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2784" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op980" value="DMA 表达　K装/K入、V装/V入、O取/O回分别展示每笔传输的读端与写端，两端同时活动；每笔传输只在实际占用的各接口上计费一次。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2818" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op981" value="默认接口　DDR读/写各200 GB/s×70%=140 B/c；L1读/写各512 B/c；Vector读/写各256 B/c；Tensor读/写分配256 B/c。Q已在L1，K/V经DMA装入。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2852" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op982" value="数据与复用　Q/K/V/P/O为BF16，S/Y及m/ℓ/A为FP32；Vector中间值与状态本地驻留。Tensor微步输入1280 B/c由局部暂存重复供数，局部带宽与足够容量为建模假设。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2886" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op983" value="依赖　QK→S写→S读→SC→RM→MX→SU→EP；MX→DL→EA；EP→RS及CV→P写→P读→PV；EA→LM→LA，RS→LA；EA→AM→AA，PV→Y写→Y读→AA。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2920" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op984" value="反馈　MX[j−1]→MX[j]；LA[j−1]→LM[j]；AA[j−1]→AM[j]。归约按4032次二元操作计，64并行度对应63 c；完整有效tile的mask无需附加计算。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2954" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op985" value="核验结果　逐周期检查依赖、共享资源互斥、读写带宽以及末尾回写。L1峰值读512 B/c、写396 B/c；固定槽配置136 KiB，另计输出16 KiB与本地暂存。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="2988" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op986" value="下界与利用率　EXP 520 c，Tensor 512 c，基础ALU 452 c，REDMAX/REDSUM各63 c。排程达到II=520 c；EXP 100%，Tensor 98.46%，ALU 86.92%，归约单元各12.12%。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="3022" width="4660" height="32" as="geometry" />
        </mxCell>
        <mxCell id="op987" value="真实矩阵结果延迟　256次微步从t到t+255发射，最后结果在t+270可见。图上发射256 c，尾部14 c；其他操作的短块按真实时长绘制，文字仅作旁注。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="25" y="3056" width="4660" height="32" as="geometry" />
