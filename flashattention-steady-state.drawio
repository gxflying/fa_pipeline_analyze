  <diagram id="fa-steady-state" name="稳态流水线与反馈">
    <mxGraphModel dx="1426" dy="841" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="600" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="FlashAttention 前向流水线" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontStyle=1;fontColor=#182B42;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="830" height="44" as="geometry" />
        </mxCell>
        <mxCell id="3" value="同一 Q 块沿 KV 维扫描。蓝色为共用 Tensor，绿色为 Vector，虚线为同一 Q 块的跨 tile 状态。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#425C75;" parent="1" vertex="1">
          <mxGeometry x="40" y="75" width="1170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;DDR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px&quot;&gt;K / V 预取&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#7B8EA5;strokeWidth=1.4;fontColor=#182B42;fontSize=16;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="146" height="68" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;共享 L1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px&quot;&gt;Q、K、V、S、窄 P、Y&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#7B8EA5;strokeWidth=1.4;fontColor=#182B42;fontSize=16;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="235" y="130" width="205" height="68" as="geometry" />
        </mxCell>
        <mxCell id="6" value="K/V 预取与 S、窄 P、Y 交接都占用共享 L1 端口。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#425C75;" parent="1" vertex="1">
          <mxGeometry x="493" y="145" width="680" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;QK&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px&quot;&gt;QKᵀ&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E4EEFA;strokeColor=#567BA7;strokeWidth=1.4;fontColor=#182B42;fontSize=16;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
