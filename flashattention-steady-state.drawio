        <mxCell id="286" value="ceil(M/P_add) = 1" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="3355" y="1573" width="785" height="30" />
        </mxCell>
        <mxCell id="287" value="Y读  　[1814, 1942)　32 KiB" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="2775" y="1607" width="580" height="30" />
        </mxCell>
        <mxCell id="288" value="ceil(MD·b_Y/min(V_bw_r/f, L1_r/f)) = 128" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="3355" y="1607" width="785" height="30" />
        </mxCell>
        <mxCell id="289" value="AM  αA_old　[2276, 2404)　— KiB" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="2775" y="1641" width="580" height="30" />
        </mxCell>
        <mxCell id="290" value="ceil(MD/P_mul) = 128" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="3355" y="1641" width="785" height="30" />
        </mxCell>
        <mxCell id="291" value="AA  αA_old+Y　[2404, 2532)　— KiB" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="2775" y="1675" width="580" height="30" />
        </mxCell>
        <mxCell id="292" value="ceil(MD/P_add) = 128" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="3355" y="1675" width="785" height="30" />
        </mxCell>
        <mxCell id="293" value="依赖与反馈  QK→S→SC→RM→MX→SU→EP，EP 分支至 RS 与 CV→P→PV→Y；EA 同时供 ℓ/A 重标；MX[j−1]→MX[j]，LA[j−1]→LM[j]，AA[j−1]→AM[j]。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1797" width="4140" height="35" />
        </mxCell>
        <mxCell id="294" value="末块收尾按需执行  RCP=ceil(M/P_rcp)=8 c，O=A·RCP=ceil(MD/P_mul)=128 c，O转换=128 c，Vector写O=ceil(16384/256)=64 c，DDR写O=ceil(16384/140)=118 c；对应独立延迟参数另加。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1837" width="4140" height="35" />
        </mxCell>
        <mxCell id="295" value="微步结果可见时刻为 issue+15，256 次从 t 到 t+255 发射，整块末结果在 t+270 可见；图上实心发射 256 c，虚线尾部 14 c。完整 j 从 K装到 AA 跨 3114 c，稳态每 520 c 产出一块。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1877" width="4140" height="35" />
        </mxCell>
        <mxCell id="296" value="下界核对  max(Tensor 512，EXP 520，RM 504，RS 504，ALU 452，DDR读整块占用 236，L1读 208，L1写 176，Vector读 192，Vector写 32) = 520 c；本图排程达到此下界。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1917" width="4140" height="35" />
        </mxCell>
        <mxCell id="297" value="L1 槽位  Q常驻16 KiB + K 1×16 KiB + V 4×16 KiB + S 1×16 KiB + P 1×8 KiB + Y 1×32 KiB = 152 KiB。V 提前预取的生命周期跨4个节拍。主循环取长期稳态，首块初始化与末块收尾另计。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1957" width="4140" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fa-operation-lanes-reduce64" name="逐项操作泳道·归约64">
