        </mxCell>
        <mxCell id="8" value="&lt;b&gt;评分与行最大值&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px&quot;&gt;scale / mask → REDMAX → m&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F2EB;strokeColor=#59866E;strokeWidth=1.4;fontColor=#182B42;fontSize=16;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
