          <mxGeometry x="25" y="75" width="4400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="op4" value="每次 MUL / ADD / SUB / EXP 均有独立行，左侧标出实际共用资源。横轴 cycle = ns；所有执行块均为 1 px/cycle。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="25" y="116" width="4650" height="30" as="geometry" />
        </mxCell>
        <mxCell id="op5" value="窗口从已进入稳态的位置开始，j+3 是此 Q 块的最后一个 KV tile；之后真实绘制倒数、归一化、转换和输出回写。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="25" y="152" width="4650" height="30" as="geometry" />
        </mxCell>
        <mxCell id="op6" value="颜色按 KV tile 区分，深蓝表示最终输出。虚线窄块表示 Tensor 尾延迟。1-cycle 操作保留真实宽度，右侧引出名称与时长。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=18;" parent="1" vertex="1">
