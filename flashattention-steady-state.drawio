        <mxCell id="226" value="符号参数  M=N=64，D=128，f=1 GHz；(m_t,k_t,n_t)=(4,32,16)；T_ops=m_t·k_t·n_t=2048 MAC/c；L_T=15 c；η_DDR=0.7。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1074" width="4140" height="30" />
        </mxCell>
        <mxCell id="227" value="DDR_BW_r=DDR_BW_w=200 GB/s → 有效各 140 B/c；L1_r=L1_w=512 GB/s；L1_size 按 SRAM 几何取 512 KiB；V_bw_r=V_bw_w=256 GB/s。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1104" width="4140" height="30" />
        </mxCell>
        <mxCell id="228" value="P_add=P_sub=P_mul=P_max=P_cvt=64；P_exp=P_div=P_rcp=P_sqrt=P_redmax=P_redsum=8，全部为独立参数。REDMAX、REDSUM 各一套单元。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1134" width="4140" height="30" />
        </mxCell>
        <mxCell id="229" value="L_add、L_sub、L_mul、L_max、L_cvt、L_exp、L_div、L_rcp、L_sqrt、L_redmax、L_redsum 分别保留参数，未给出的额外尾延迟默认 0。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1164" width="4140" height="30" />
        </mxCell>
        <mxCell id="230" value="基础 ALU 与 CVT 共用发射资源；EXP 与两种归约可并发。归约按二元操作计，W=M(N−1)；若硬件规格按输入元素/c，需替换服务式。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1194" width="4140" height="30" />
        </mxCell>
        <mxCell id="231" value="Tensor 采用局部操作数复用与多累加器交错，K 维同一累加器重访间隔 ≥15 c；L1 分配 B_Talloc=256 B/c，留出 Vector 并发带宽。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1224" width="4140" height="30" />
        </mxCell>
        <mxCell id="232" value="Tensor 微步的两个输入共 1280 B/c，局部暂存负责重复供数；此局部带宽和容量为补充假设。Q 已在 L1；第二个 K[64,128] 按 V 解读。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1254" width="4140" height="30" />
        </mxCell>
        <mxCell id="233" value="b_Q=b_K=b_V=b_P=b_O=2 B（BF16），b_S=b_Y=b_A=b_state=4 B（FP32）；m/ℓ/A、Vector 中间值及旧 m 版本在本地。稳态选完整有效 tile。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1284" width="4140" height="30" />
        </mxCell>
        <mxCell id="234" value="验证周期依赖、物理单元互斥、共享 L1 读写峰值和槽生命周期。独立 L1 槽预算 152 KiB ≤512 KiB，另外预留本地 scratch 与状态。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1314" width="4140" height="30" />
        </mxCell>
        <mxCell id="235" value="共享 L1 峰值读 512 B/c、写 512 B/c。DMA 同一传输同时占 DDR 读和 L1 写，Tensor 尾延迟不占用发射口。" parent="1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#19324A;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="35" y="1344" width="4140" height="30" />
        </mxCell>
